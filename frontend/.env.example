# Demo mode is self-contained and is the default for Preview.
MOCK_API=true
DEMO_MODE=true
MAX_MESSAGE_CHARS=500
RATE_LIMIT_MESSAGES_PER_HOUR=30

# Leave blank for the local Express BFF. On Vercel, set this to the public
# origin of the Render Express BFF (for example https://pulsecheck-bff.onrender.com).
VITE_API_BASE_URL=

# Python integration mode (combined FastAPI agent + CRM from service.py):
# 1. Start the Python service on port 8001 from the repository root.
# 2. Uncomment the settings below and restart the Node server.
#
# MOCK_API=false
# AGENT_API_URL=http://127.0.0.1:8001
# CRM_API_URL=http://127.0.0.1:8001/crm
# INTERNAL_API_KEY=

# These URLs and key stay server-side; they are never exposed to the browser.
AGENT_API_URL=
CRM_API_URL=
INTERNAL_API_KEY=
CORS_ORIGIN=
CORS_ORIGINS=
PORT=3000
