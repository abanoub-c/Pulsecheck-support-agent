# Copy this file to .env in the repository root. Keep real secrets in .env,
# and enter deployment values in Render/Vercel settings rather than committing them.

# Shared Python agent + CRM
GROQ_API_KEY=your-groq-api-key
PULSECHECK_DATABASE_URL=sqlite:///./pulsecheck.db
INTERNAL_API_KEY=replace-with-a-long-random-secret
AGENT_PORT=8001
AGENT_API_URL=http://127.0.0.1:8001
CRM_API_URL=http://127.0.0.1:8001/crm
API_BASE=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000
DEMO_CUSTOMER_IDS=
MAX_MESSAGE_CHARS=500
MAX_THREADS=500
PULSECHECK_ENABLE_ADMIN=1

# Browser/BFF (PORT is supplied by Render in production)
NODE_ENV=development
FRONTEND_PORT=3000
MOCK_API=false
DEMO_MODE=true
RATE_LIMIT_MESSAGES_PER_HOUR=30
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN=
VITE_API_BASE_URL=

# Agent behavior
MAX_SPECIALIST_STEPS=8
SESSION_GAP_HOURS=1
MAX_RAW_MESSAGES=20
KEEP_RECENT_MESSAGES=8

# Shared LLM settings for router, specialists, and conversation summarizer
# Change LLM_PROVIDER and LLM_MODEL together when switching providers.
# Providers: groq, openai, anthropic, openai-compatible
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_ROUTER_TEMPERATURE=
LLM_SPECIALIST_TEMPERATURE=
LLM_SUMMARIZER_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=
# Providers supporting structured output can use json_schema; set function_calling if needed.
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional LangSmith tracing
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pulsecheck-support
